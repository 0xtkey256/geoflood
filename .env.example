# ---- Nosana: deploy a vLLM/Ollama template from the Nosana dashboard, copy the service URL ----
# URL looks like https://<job-id>.node.k8s.prd.nos.ci  -> append /v1
NOSANA_BASE_URL=https://REPLACE-job-id.node.k8s.prd.nos.ci/v1
# leave empty to auto-discover from /v1/models (vLLM), or set e.g. Qwen/Qwen2.5-Coder-7B-Instruct
NOSANA_MODEL=
NOSANA_API_KEY=nosana

# ---- Daytona: https://app.daytona.io -> API Keys ----
DAYTONA_API_KEY=
# optional: run `python -m agent.sandbox` once to pre-build, then set:
DAYTONA_SNAPSHOT=

# ---- Neo4j Aura: https://console.neo4j.io (free instance) ----
NEO4J_URI=neo4j+s://REPLACE.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- optional LLM fallbacks if Nosana is down ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- kill switches: 0 = force mock for that platform ----
USE_NOSANA=1
USE_DAYTONA=1
USE_NEO4J=1
